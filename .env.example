NEO4J_PASSWORD=change-me-at-least-8-chars
KGRAG_PROJECT_BUDGET_USD=40

# LLM provider: claude-code (the `claude` CLI, logged in) or openai (any OpenAI-compatible server).
KGRAG_LLM_PROVIDER=claude-code
# KGRAG_MODEL=claude-haiku-5-5            # extraction and entity checks
# KGRAG_AGENT_MODEL=claude-haiku-5-5      # the agent that plans and answers
# KGRAG_JUDGE_MODEL=claude-sonnet-5-5     # benchmark grading

# For KGRAG_LLM_PROVIDER=openai:
# OPENAI_BASE_URL=https://api.openai.com/v1   # or http://localhost:11434/v1 for Ollama
# OPENAI_API_KEY=sk-...
# KGRAG_PRICE_INPUT_PER_MTOK=0               # USD per million tokens; 0 for local models
# KGRAG_PRICE_OUTPUT_PER_MTOK=0
